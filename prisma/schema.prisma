generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  phone              String   @unique
  password           String
  email              String?
  role               String   @default("CLIENT") // CLIENT, PRESTATAIRE, ENTREPRISE, ADMIN
  status             String   @default("approved") // pending, approved, rejected, suspended
  autoReplyMessage   String?
  deletionReason     String?
  deletionRequestedAt DateTime?
  emailOtpHash       String?
  emailOtpPurpose    String? // "login" | "reset"
  emailOtpExpiresAt  DateTime?
  emailOtpAttempts   Int      @default(0)
  emailOtpSentAt     DateTime?
  adminMustChangePassword Boolean @default(false)
  certified          Boolean  @default(false)
  certificationStatus String? // "pending" | "rejected" | null (null = none/approved)
  certificationMessage String?
  certificationRequestedAt DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  clientProfile      ClientProfile?
  providerProfile    ProviderProfile?
  companyProfile     CompanyProfile?
  reviewsWritten     Review[]
  reviewsReceived    Review[]  @relation("ReviewedUser")
  notifications      Notification[]
  contactMessages    ContactMessage[]
  announcementsSent  AdminAnnouncement[] @relation("AnnouncementAuthor")
  conversations1     Conversation[] @relation("ConvParticipant1")
  conversations2     Conversation[] @relation("ConvParticipant2")
  chatMessages       ChatMessage[]
  activities         UserActivity[]
  serviceRequestsAsClient ServiceRequest[] @relation("RequestClient")
  serviceRequestsAsProvider ServiceRequest[] @relation("RequestProvider")
  quotes             Quote[] @relation("QuoteProvider")
  contractsAsClient  Contract[] @relation("ContractClient")
  contractsAsProvider Contract[] @relation("ContractProvider")
  paymentsAsPayer    Payment[] @relation("PaymentPayer")
  paymentsAsBeneficiary Payment[] @relation("PaymentBeneficiary")
  paymentAccounts    PaymentAccount[]
  subscriptions      Subscription[]
  disputesOpened     Dispute[] @relation("DisputeOpenedBy")
}

model ClientProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String?
  email     String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProviderProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  fullName      String
  email         String
  phone         String
  photoUrl      String?
  slug          String?  @unique
  sector        String
  service       String
  services      String?  // JSON array
  province      String?
  commune       String?
  description   String?
  experience    String?  // professional experience
  availability  String?  // availability description
  socialMedia   String?  // JSON string
  nationalScope Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CompanyProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  companyName   String
  email         String
  phone         String
  logoUrl       String?
  coverPhotoUrl String?
  slug          String?  @unique
  sector        String
  companyType   String   @default("individuelle")
  employeeCount Int?
  hasEmployees  Boolean  @default(false)
  documents     String?  // JSON array of document URLs
  website       String?
  fullAddress   String?
  description   String?
  services      String?
  province      String?
  commune       String?
  socialMedia   String?
  nationalScope Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employees     Employee[]
}

model Employee {
  id              String   @id @default(cuid())
  companyId       String
  fullName        String
  function        String
  phone           String?
  email           String?
  photoUrl        String?
  isManager       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Review {
  id          String   @id @default(cuid())
  authorId    String
  targetId    String
  targetType  String
  rating      Int
  comment     String?
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  target      User     @relation("ReviewedUser", fields: [targetId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  reply     String?
  repliedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AdminAnnouncement {
  id          String   @id @default(cuid())
  authorId    String
  title       String
  message     String
  targetType  String
  targetId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      User     @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)
}

model Conversation {
  id              String   @id @default(cuid())
  participant1Id  String
  participant2Id  String
  lastMessageAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  participant1    User     @relation("ConvParticipant1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2    User     @relation("ConvParticipant2", fields: [participant2Id], references: [id], onDelete: Cascade)

  messages        ChatMessage[]

  @@unique([participant1Id, participant2Id])
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model PlatformSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model AdminAction {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())
}

model Realisation {
  id          String   @id @default(cuid())
  userId      String
  userRole    String   // PRESTATAIRE or ENTREPRISE
  title       String
  description String?
  media       String   @default("[]") // JSON array of image/video URLs
  mediaType   String   @default("image") // image, video, album
  beforePhoto String?  // before photo for before/after
  afterPhoto  String?  // after photo for before/after
  location    String?
  date        String?  // project date
  tags        String?  // JSON array of tags
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  action    String   // login, logout, profile_update, password_change, etc.
  details   String?  // JSON with extra info (ip, device, etc.)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ServiceRequestStatus {
  DRAFT
  PUBLISHED
  QUOTE_SENT
  ACCEPTED
  PAYMENT_PENDING
  FUNDS_RECEIVED
  ESCROWED
  IN_PROGRESS
  DELIVERED
  CLIENT_REVIEW
  RELEASED
  COMPLETED
  DISPUTED
  ADMIN_REVIEW
  RESOLVED
  REFUNDED
  PARTIAL_RELEASE
  CANCELLED
}

model ServiceRequest {
  id              String @id @default(cuid())
  clientId        String
  providerId      String?
  title           String
  description     String
  service         String
  province        String?
  district        String?
  commune         String?
  budgetMin       Decimal? @db.Decimal(14, 2)
  budgetMax       Decimal? @db.Decimal(14, 2)
  scheduledAt     DateTime?
  urgent          Boolean @default(false)
  status          ServiceRequestStatus @default(DRAFT)
  idempotencyKey  String @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  client          User @relation("RequestClient", fields: [clientId], references: [id], onDelete: Cascade)
  provider        User? @relation("RequestProvider", fields: [providerId], references: [id], onDelete: SetNull)
  quotes          Quote[]
  contract        Contract?
}

model Quote {
  id             String @id @default(cuid())
  requestId      String
  providerId     String
  amount         Decimal @db.Decimal(14, 2)
  currency       String @default("CDF")
  message        String?
  validUntil     DateTime?
  status         String @default("SENT")
  idempotencyKey String @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  request        ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider       User @relation("QuoteProvider", fields: [providerId], references: [id], onDelete: Cascade)
  contract       Contract?
}

model Contract {
  id             String @id @default(cuid())
  requestId      String @unique
  quoteId        String @unique
  clientId       String
  providerId     String
  amount         Decimal @db.Decimal(14, 2)
  currency       String @default("CDF")
  commissionRate Decimal @db.Decimal(5, 2)
  status         ServiceRequestStatus @default(ACCEPTED)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  request        ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  quote          Quote @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  client         User @relation("ContractClient", fields: [clientId], references: [id], onDelete: Cascade)
  provider       User @relation("ContractProvider", fields: [providerId], references: [id], onDelete: Cascade)
  payments       Payment[]
  milestones     Milestone[]
  escrowTransactions EscrowTransaction[]
  disputes       Dispute[]
}

model Payment {
  id             String @id @default(cuid())
  contractId     String?
  payerId        String
  beneficiaryId  String?
  provider       String @default("MPESA")
  externalReference String? @unique
  transactionReference String? @unique
  proofUrl       String?
  rejectionReason String?
  verifiedAt     DateTime?
  amount         Decimal @db.Decimal(14, 2)
  fee            Decimal @db.Decimal(14, 2) @default(0)
  commission     Decimal @db.Decimal(14, 2) @default(0)
  currency       String @default("CDF")
  status         String @default("PENDING")
  purpose        String @default("MISSION")
  idempotencyKey String @unique
  metadata       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  contract       Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  payer          User @relation("PaymentPayer", fields: [payerId], references: [id], onDelete: Cascade)
  beneficiary    User? @relation("PaymentBeneficiary", fields: [beneficiaryId], references: [id], onDelete: SetNull)
  escrow         EscrowTransaction?
  releases       EscrowRelease[]
  refunds        Refund[]
  subscriptionPayment SubscriptionPayment?
}

model PaymentAccount {
  id          String @id @default(cuid())
  userId      String
  operator    String
  phone       String
  holderName  String
  bankName    String?
  accountNumber String?
  branch      String?
  swift       String?
  isDefault   Boolean @default(false)
  maskedPhone String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, isDefault])
}

model EscrowTransaction {
  id          String @id @default(cuid())
  paymentId   String @unique
  contractId  String
  amount      Decimal @db.Decimal(14, 2)
  status      String @default("ESCROWED")
  heldAt      DateTime @default(now())
  releasedAt  DateTime?
  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  releases    EscrowRelease[]
}

model Milestone {
  id          String @id @default(cuid())
  contractId  String
  title       String
  description String?
  percentage  Decimal @db.Decimal(5, 2)
  amount      Decimal @db.Decimal(14, 2)
  position    Int
  status      String @default("PENDING")
  dueAt       DateTime?
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  releases    EscrowRelease[]
  @@unique([contractId, position])
}

model EscrowRelease {
  id          String @id @default(cuid())
  escrowId    String
  paymentId   String
  milestoneId String?
  amount      Decimal @db.Decimal(14, 2)
  commission  Decimal @db.Decimal(14, 2)
  status      String @default("PENDING")
  releasedAt  DateTime?
  idempotencyKey String @unique
  escrow      EscrowTransaction @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
}

model Refund {
  id          String @id @default(cuid())
  paymentId   String
  amount      Decimal @db.Decimal(14, 2)
  reason      String
  status      String @default("PENDING")
  externalReference String?
  createdAt   DateTime @default(now())
  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Dispute {
  id          String @id @default(cuid())
  contractId  String
  openedById  String
  reason      String
  description String
  status      String @default("OPEN")
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  openedBy    User @relation("DisputeOpenedBy", fields: [openedById], references: [id], onDelete: Cascade)
}

model Subscription {
  id          String @id @default(cuid())
  userId      String
  plan        String
  price       Decimal @db.Decimal(14, 2)
  currency    String @default("CDF")
  commissionRate Decimal @db.Decimal(5, 2)
  startsAt    DateTime
  endsAt      DateTime
  status      String @default("PENDING")
  createdAt   DateTime @default(now())
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment     SubscriptionPayment?
}

model SubscriptionPayment {
  id             String @id @default(cuid())
  subscriptionId String @unique
  paymentId      String @unique
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payment        Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Advertisement {
  id          String @id @default(cuid())
  ownerId     String
  title       String
  target      String
  budget      Decimal @db.Decimal(14, 2)
  status      String @default("DRAFT")
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())
}

model Promotion {
  id          String @id @default(cuid())
  userId      String
  plan        String
  price       Decimal @db.Decimal(14, 2)
  startsAt    DateTime
  endsAt      DateTime
  status      String @default("PENDING")
  createdAt   DateTime @default(now())
}

model Invoice {
  id          String @id @default(cuid())
  contractId  String?
  paymentId   String?
  number      String @unique
  total       Decimal @db.Decimal(14, 2)
  currency    String @default("CDF")
  createdAt   DateTime @default(now())
}
